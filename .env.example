# Configurações de Ambiente - Plaisio Org

# Ambiente da aplicação
# Valores possíveis: development, production
VITE_APP_ENV=development

# Nome da aplicação
VITE_APP_NAME=Plaisio Org

# Versão da aplicação
VITE_APP_VERSION=1.0.0

# Configurações de LocalStorage
# Nome da chave usada para armazenar dados no LocalStorage
VITE_STORAGE_KEY=plaisio-org-storage

# Configurações de Debug
# Habilita logs detalhados no console (apenas em desenvolvimento)
VITE_DEBUG=false

# Configurações de Monitoramento de Erros (opcional)
# URL do serviço de monitoramento de erros (ex: Sentry)
# VITE_ERROR_TRACKING_URL=

# Configurações de Analytics (opcional)
# ID do Google Analytics ou similar
# VITE_ANALYTICS_ID=
